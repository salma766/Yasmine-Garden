# PostgreSQL (on Vercel: add a Neon database from the Storage tab, it fills these in)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Long random string used to sign admin sessions (openssl rand -base64 32)
AUTH_SECRET=""

# First administrator account, created by `npm run db:seed`
ADMIN_EMAIL="admin@yasmine-gardens.tn"
ADMIN_PASSWORD=""

# Public URL of the site, used for canonical URLs, hreflang and the sitemap
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# Optional: image uploads on Vercel (add a Blob store from the Storage tab)
BLOB_READ_WRITE_TOKEN=""

# Optional: enables the AI translation assistant in the admin
ANTHROPIC_API_KEY=""
